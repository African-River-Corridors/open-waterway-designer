      "class": "outcome",
      "tolerance": { "relative": 0.02 },
      "source": "SOURCE.md#the-volume"
    },
    {
      "name": "dry_cut_m3",
      "read": { "pointer": "/stages/volumes/results/options/0/excav_m3" },
