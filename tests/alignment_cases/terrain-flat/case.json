      "tolerance": { "absolute": 1e-9 },
      "source": "SOURCE.md#the-channel"
    },
    {
      "name": "design_depth_m",
      "read": { "pointer": "/stages/sizing/results/design_depth_m" },
      "value": 3.25,
      "class": "exact",
      "tolerance": { "absolute": 1e-9 },
      "source": "SOURCE.md#the-channel"
    },
    {
      "name": "dredge_m3",
      "read": { "pointer": "/stages/volumes/results/options/0/dredge_m3" },
