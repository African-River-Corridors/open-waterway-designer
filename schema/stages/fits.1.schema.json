{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageRecord",
  "description": "One stage as the document stores it.",
  "type": "object",
  "properties": {
    "version": {
      "description": "The version of the stage's contract: which schema its settings and output follow.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "depends_on": {
      "description": "The hash of the input the stage read, so staleness can be worked out on load. Absent until\nthe stage has run.",
      "type": [
        "string",
        "null"
      ]
    },
    "settings": {
      "description": "The settings the stage ran with (or will run with).",
      "$ref": "#/$defs/FitsIn"
    },
    "output": {
      "description": "What the stage returned. Absent until the stage has run.",
      "anyOf": [
        {
          "$ref": "#/$defs/FitsAnswer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "settings"
  ],
  "$defs": {
    "FitsIn": {
      "description": "What the fits stage reads.",
      "type": "object",
      "properties": {
        "plan_line": {
          "description": "The line the classes were read on: the fresh reference line, the centreline, or (for the\nfairway) the centreline the fairway is made from.",
          "$ref": "#/$defs/Polyline"
        },
        "plan_line_kind": {
          "description": "`reference`, `centreline` or `fairway`.",
          "type": "string"
        },
        "river_polygon": {
          "description": "The river as water.",
          "$ref": "#/$defs/RiverPolygon"
        },
        "custom_vessel": {
          "description": "The custom vessel, with a row of its own when there is one.",
          "default": null
        },
        "settings": {
          "description": "The answer's settings, as stored."
        },
        "full": {
          "description": "For a full answer, what it read beyond the plan.",
          "anyOf": [
            {
              "$ref": "#/$defs/FitsFullIn"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "plan_line",
        "plan_line_kind",
        "river_polygon",
        "settings"
      ]
    },
    "Polyline": {
      "description": "A line in the project CRS: `[x, y]` points in order.",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "format": "double"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "RiverPolygon": {
      "description": "The river as water: an outer ring and the islands cut out of it. A ring is a [`Polyline`] that is\nclosed by implication (the last point joins the first).",
      "type": "object",
      "properties": {
        "shell": {
          "description": "The outer ring.",
          "$ref": "#/$defs/Polyline"
        },
        "holes": {
          "description": "Islands: each is dry land inside the shell.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Polyline"
          }
        }
      },
      "required": [
        "shell"
      ]
    },
    "FitsFullIn": {
      "description": "What a full answer reads beyond the plan.",
      "type": "object",
      "properties": {
        "bed_model": true,
        "water_level": true,
        "dem_sha256": {
          "description": "The DEM, by its hash."
        },
        "sizing_rule_sets": {
          "description": "The sizing's Rule Set selection."
        },
        "bed_axis": {
          "description": "The reference line the assumed bed is centred on, by its hash, when fresh.",
          "default": null
        },
        "dem_holds_bathymetry": {
          "type": "boolean"
        }
      },
      "required": [
        "bed_model",
        "water_level",
        "dem_sha256",
        "sizing_rule_sets",
        "dem_holds_bathymetry"
      ]
    },
    "FitsAnswer": {
      "description": "What the fits stage returns, as the study keeps it (`fits.results`).",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "length_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "rule_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FitsRuleSet"
          }
        },
        "mode": {
          "description": "`full` for a full answer; absent for a plan-only one.",
          "type": [
            "string",
            "null"
          ]
        },
        "plan_line": {
          "type": "string"
        },
        "plan_line_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules_notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "draught_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "rule_sets",
        "plan_line"
      ]
    },
    "FitsRuleSet": {
      "description": "The answer for one Rule Set choice.",
      "type": "object",
      "properties": {
        "rule_set": {
          "type": "string"
        },
        "selection": {
          "description": "The Rule Set and set input the choice stands for (null when it stands for none)."
        },
        "largest_fitting": {
          "type": [
            "string",
            "null"
          ]
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FitsClass"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "rule_set",
        "selection",
        "classes"
      ]
    },
    "FitsClass": {
      "description": "One vessel class (or the custom vessel) in the answer. A full answer adds what the depth and the\nscreening found; a plan-only one leaves those out.",
      "type": "object",
      "properties": {
        "vessel_standard_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "class_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "formation": {
          "type": [
            "string",
            "null"
          ]
        },
        "loa_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "beam_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "r_min_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "radius_check_chord_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "bottom_width_straight_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "fits": {
          "type": "boolean"
        },
        "worst_width_deficit_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "worst_radius_deficit_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "stretch_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "stretches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StretchOut"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "label": {
          "description": "What the row read, and what it did not.",
          "type": "string"
        },
        "vessel_label": {
          "description": "The custom vessel's label (it has no class id).",
          "type": [
            "string",
            "null"
          ]
        },
        "custom": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "plan_line": {
          "description": "Full answer: the line the row read.",
          "type": [
            "string",
            "null"
          ]
        },
        "plan_line_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "description": "Full answer: the screening verdict (spec 0007).",
          "type": [
            "string",
            "null"
          ]
        },
        "constraint_stretches": {
          "description": "Full answer: the constraint stretches, as the screening writes them."
        },
        "blocking_not_evaluated": true,
        "depth_basis": {
          "description": "Full answer: where the depth came from."
        }
      },
      "additionalProperties": false,
      "required": [
        "fits",
        "stretch_count",
        "stretches",
        "warnings",
        "label"
      ]
    },
    "StretchOut": {
      "description": "One stretch where a size does not fit.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "start_chainage_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "end_chainage_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "start": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "end": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "required_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "found_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "deficit_m": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ]
    }
  }
}
